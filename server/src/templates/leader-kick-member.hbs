<html>
  <head>
    <style>
      .email-container {
        font-family: Arial, sans-serif;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #007bff;
        color: white !important;
        text-decoration: none;
        border-radius: 5px;
        margin-top: 15px;
      }
      .button:hover {
        background-color: #0056b3;
      }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <h2>A Member Has Been Kicked Out of Your Project</h2>
      <p>Hello members of "{{project_name}}",</p>
      <p>We would like to inform you that {{member}} has been removed from the project "{{project_name}}" by {{leader}}.</p>

      <p style='font-size: 14px; color: #555;'>
        This action was performed on: {{sentTime}}
      </p>

      <p style='margin-top: 20px;'>
        <a href='{{projectUrl}}' class='button' target='_blank' rel='noopener noreferrer'>
          View Updated Team Details
        </a>
      </p>
      <p style='color: #666; font-size: 12px; margin-top: 20px;'>
        If the button above doesn't work, copy and paste this URL into your browser:<br />
        <span style='color: #007bff;'>{{projectUrl}}</span>
      </p>
    </div>
  </body>
</html>
